# Edycja i eksport Hyperframes nie wymagają kluczy API.
# Opcjonalna korekta napisów. Bez klucza działa lokalny Whisper i korekta regułami.
GEMINI_API_KEY=
GEMINI_TRANSCRIPT_MODEL=gemini-2.5-flash
# Jeśli Whisper jest zainstalowany w innym interpreterze, wpisz jego ścieżkę.
WHISPER_PYTHON=python
# Dodatkowy research i analiza komentarzy.
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
# Opcjonalna analiza Google Cloud: plik konta usługi lub OAuth / ADC.
GOOGLE_VIDEO_INTELLIGENCE_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Konta nowego schedulera dodawaj w UI: Publikacje → Konta i klucze.
# Sekrety są szyfrowane lokalnie. R2 korzysta z istniejącego logowania Wrangler OAuth.
# Poniższe zmienne dotyczą wyłącznie archiwalnego CLI genius-scale.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
