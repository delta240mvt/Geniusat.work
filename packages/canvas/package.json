{
  "name": "@genius/canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "dotenv": "^16.6.1",
    "wrangler": "4.131.1"
  },
  "description": "Reusable workspace canvas viewer for analysis JSON and split-screen preview playback.",
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test src/index.test.ts src/reels-ui.test.ts src/publisher/*.test.ts"
  }
}
